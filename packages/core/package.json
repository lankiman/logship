{
  "name": "logship",
  "author": "Gboun Marvellous",
  "description": "A lightweight, configurable TypeScript logging library for Node.js with structured logging, rotating file transports, Grafana Loki integration, and NestJS support.",
  "version": "1.0.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts --clean"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
